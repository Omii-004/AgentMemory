# Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
POSTGRES_USER=<your_db_user>
POSTGRES_PASSWORD=<your_db_password>
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentmemory
DATABASE_URL=postgresql+asyncpg://<your_db_user>:<your_db_password>@localhost:5432/agentmemory
DATABASE_URL_SYNC=postgresql://<your_db_user>:<your_db_password>@localhost:5432/agentmemory

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Provider Configuration (Optional for initial tests, default to local/mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gpt-4o-mini